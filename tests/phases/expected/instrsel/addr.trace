%ne($r[4], $V[0] + (<out ovfl results:o4> + -4)) --> $r[4] := $V[0] + (<out ovfl results:o4> + -4)
<return> $c[0] := bits32L[$r[4]] | $r[4] := $r[4] + 4 []
