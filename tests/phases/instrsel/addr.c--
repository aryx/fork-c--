target byteorder little;

// Toy example for instruction selection: an array load bits32[base+4*i]
// is the same three abstract operations - multiply, add, load - on every
// target, but which concrete instruction spells each one out is
// target-specific: compare this file's generated .s (i386 imull/addl/movl)
// against addr_ppc.c--'s (same source, -ppc: mullw/add/lwz). Neither
// target folds the *4 into a shift or into the load's own addressing mode
// here - this compiler doesn't do strength reduction or addressing-mode
// folding at the default -O0 (see tests/optimizer/'s showcases for the
// opti/ passes that do run), so the two targets' output differs only in
// mnemonics, not in shape - itself a useful thing to see change once such
// a pass exists. QCDEBUG=instrsel-cfg's dumps (still `%mul`/`%add`,
// unlowered - see max.c--'s header comment for why) show that the two
// targets haven't diverged yet at that stage; the divergence is entirely
// in arch/x86/x86rec.mlb vs arch/ppc/ppcrec.mlb's choice of mnemonic for
// the same machine-independent-turned-machine-dependent RTL. Run:
//   QCDEBUG=instrsel-cfg qc -stop .s -o /dev/null addr.c--
//   QCDEBUG=instrsel-cfg qc -ppc -stop .s -o /dev/null addr_ppc.c--
export at;
at(bits32 base, bits32 i) {
  bits32 v;
  v = bits32[base + 4*i];
  return(v);
}
