target byteorder little;

// Toy example for Optimize.remove_nops (opti/optimize.ml).
//
// An empty procedure body still goes through the full x86 prologue/vfp
// setup and epilogue/vfp teardown, and at -O0 that machinery leaves behind
// RTLs remove_nops recognizes as no-ops: Kill effects (emitted as literal
// "nop" instructions) and self-stores "l := fetch(l)" (emitted as
// "movl %r,%r"). There is no arithmetic here for Optimize.simplify_exps to
// fold, so the nop/self-move removal is remove_nops' effect specifically.
// Peephole.subst_forward and Optimize.elim_dead_assignments are also on at
// -O3 (see peephole.c--/elim_dead_assignments.c--) and clean up a little
// more of this function's frame setup too, so the -O0/-O3 diff has a
// little of their noise mixed in, but the nop/self-move removal is still
// the dominant, easy-to-read story.
export foo;
foo(bits32 x) { return; }
