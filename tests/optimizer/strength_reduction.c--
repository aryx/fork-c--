target byteorder little;

// Toy example for Strength_reduction.reduce (opti/strength_reduction.ml),
// built on the same cfg/dataflow/dominator.ml Dominator.Query.loops as
// licm.c--.
//
// "t = i * 4" and "i = i + 1" sit in the same block (the loop body,
// reached through header L's "if"), in that order - exactly the
// induction-variable pair this pass looks for (see its header comment for
// why same-block-and-this-order is what makes the rewrite safe), and t is
// defined nowhere else in the loop. The multiply is replaced by an
// accumulator: "t = i * 4" is duplicated unchanged into the block right
// before "goto L" (t's correct starting value, since i still holds its
// initial value 0 there - simplify_exps folds that duplicate straight
// down to "t = 0"), and the loop's own copy becomes "t = t + 4".
// At -O0 the loop computes a real "imull $4,%r,%r" every trip; at -O3
// that multiply is gone, replaced by one more "leal 4(%r),%r" alongside
// the "i = i + 1" that was already there.
export strength_reduction;
strength_reduction(bits32 n) {
  bits32 i; bits32 t;
  i = 0;
  t = 0;
  goto L;
L:
  if (i < n) {
    t = i * 4;
    i = i + 1;
    goto L;
  }
  return(t);
}
