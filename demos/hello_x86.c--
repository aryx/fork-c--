/* src: http://www.st.cs.uni-saarland.de/~lindig/#quick-cmm
 *
 * claude: exercises qc's x86 backend end to end:
 *
 *   qc -globals -stop .s -o hello.s demos/hello.c--
 *   i686-linux-gnu-as hello.s -o hello.o
 *   i686-linux-gnu-gcc -static hello.o -o hello
 *   qemu-i386 hello               # prints "hello, world!", exits 0
 *
 * -globals is required at link time even for this one-file program: see
 * driver/main.ml's comment on the exportglobals flag. i686-linux-gnu-*
 * is this fork's i386 cross toolchain (see demos/hello_ppc.c-- for the
 * ppc equivalent). qc's -as/-ld default (clang -target
 * i386-unknown-linux-gnu) assembles fine but can't link on its own here -
 * the host's ld has no elf_i386 support - so the 3-command form above is
 * needed, or equivalently one shot:
 *   qc -globals -ld "i686-linux-gnu-gcc -static" -o hello demos/hello.c--
 */

target byteorder little;

import bits32 printf;
export main, my_data;

section "data" {
  my_data: bits8 [] "hello, world!\n\0";
}

foreign "C" main("unsigned" bits32 iargc, "address" bits32 iargv) {
  foreign "C" printf("address" my_data);
  foreign "C" return(0);
}
