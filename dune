; Global build settings, applied to every subdirectory that doesn't
; override them locally.
;
; The goal here is to make dune compile this ~15 year old codebase with
; the same leniency as the legacy Makefiles (Makefile.common's
; OCAMLCFLAGS is just "-g -bin-annot -dtypes -thread", no -w at all),
; instead of dune's much stricter modern defaults.
(env
 (_
  (flags
   ; NB: this replaces dune's :standard flags entirely rather than
   ; extending them with (:standard ...). :standard for ocamlc/ocamlopt
   ; expands to roughly:
   ;   -w @1..3@5..28@30..39@43@46..47@49..57@61..62@67@69-40
   ;   -strict-sequence -strict-formats -short-paths -keep-locs
   ; The "@" warning numbers there are warnings-as-errors, and
   ; -strict-formats/-strict-sequence turn otherwise-silently-accepted
   ; legacy code (e.g. a "%03s" format directive, or an "if" without
   ; "else" returning non-unit) into hard errors. Appending "-w -a" on
   ; top of :standard is not enough to recover, since -strict-formats/
   ; -strict-sequence have no "turn it back off" flag. So we drop
   ; :standard and start from a plain, non-strict flag set instead.
   (-g        ; keep debug info, like the Makefiles' -g
    -bin-annot ; keep .cmt/.cmti generation, like the Makefiles' -bin-annot
    -w -a      ; disable every warning (legacy ocamlc default: warn, don't fail)
    -alert -deprecated ; silence deprecated-stdlib alerts (Pervasives, Stream, String.uppercase, ...)
   ))))

; principia/ is a symlink to ~/github/principia-softwarica, which contains
; further symlinks pointing back at its own root (SRC/cmd/ROOT), and dune
; refuses to scan the same path twice ("Path principia has already been
; scanned. Cannot scan it again through symlink principia/SRC/cmd/ROOT").
; Nothing in there is part of this build anyway, so keep dune out of it.
; Same workaround as in ~/github/xix's root dune.
(dirs :standard \ principia)

; NB: this.ml is normally derived from this.in via the top Makefile's
; "this.ml: this.in" rule ("cp this.in this.ml"), but this.ml is also
; checked into git directly (kept in sync manually), so dune just
; treats it as an ordinary source file - no generation rule needed here.

; TARGET=qc, SRC=this.ml driver.ml main.ml, LIBS=... in the top Makefile.
(executable
 (name main)
 ; (public_name qc) is what makes `dune install`/`dune build @install`
 ; install this binary - as "qc", not as "main" - under the "cmm" package
 ; declared in dune-project (there's only one package, so dune attaches
 ; it automatically). Without a public_name an executable is build-only
 ; and `dune install` has nothing to do for it.
 (public_name qc)
 (libraries
  num bigarray str unix
  commons ; pull lots of deps
  profiling
  cmm_commons2 cmm_error cmm_commons3 cmm_h_asdl
  cmm_parsing
  cmm_front_rtl cmm_front_asm cmm_front_fenv cmm_front_cfg
  cmm_front_nelab cmm_front_target cmm_front_zipcfg cmm_front_ir
  cmm_assembler cmm_front_last
  cmm_h_camlburg_engine
  cmm_arch_ppc cmm_arch_x86 cmm_arch_interpreter cmm_arch_dummy))
