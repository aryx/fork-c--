; Register allocation. Flowra is the dataflow-based allocator from
; TODO/backend/registers/flowra.nw; Colorgraph is a graph-coloring
; allocator; Dls (regalloc/dls.ml, tangled from OLD/dls.nw) is upstream's
; actual production allocator (Backend.x86 etc. all used Ralloc.dls, see
; regalloc/ralloc_choice.ml) - a DFS-order linear scan.
;
; The dependency on cmm_cfg_dataflow is the interesting one: it provides
; both Dataflow (the fixpoint engine) and Live (the liveness analysis
; flowra consumes). cmm_opti is for Dls's Optimize.trim_unreachable_code.
(library
 (name cmm_regalloc)
 (wrapped false)
 (libraries
  cmm_commons2 cmm_commons3 cmm_error cmm_parsing
  cmm_ir cmm_front_target
  cmm_front_nelab cmm_front_cfg cmm_front_zipcfg cmm_cfg_dataflow
  cmm_front_ir cmm_front_last cmm_assembler cmm_opti))
