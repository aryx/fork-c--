<<solution utilities>>=
let rec cross_list xs ys =
  match xs, ys with
  | [],      _  -> []
  | _,       [] -> []
  | x::rest, ys -> List.map (fun y -> [x;y]) ys @ cross_list rest ys

let rec cross_pair xs ys =
  match xs, ys with
  | [], _ -> []
  | _, [] -> []
  | x::rest, ys ->
      List.map (fun y -> (x, y)) ys @ cross_pair rest ys
