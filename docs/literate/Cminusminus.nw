{\tenv,\menv \derives e \trans{c} \e :: \h{n} : \bits{w}\\
 \oname{shra}:\bits{w}\times\bits{w}\rightarrow\bits{w}}
{\tenv,\menv \derives e \trans{c+1}\oname{shrl}(e', k_w) :: \z{w-n}:\bits{w}}
\]
