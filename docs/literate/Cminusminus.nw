    let _ = cgSay ["\nCGINFO\n"] in
    let printList iter pr (name, itemlist) =
        let indent = "        " in
        cgSay ["    "; name; ":\n"]; 
        iter (fun r -> cgSay [indent; pr r; "\n"])
