let rec cross_pair_filter p xs ys =
  match xs, ys with
  | [], _ -> []
  | _, [] -> []
  | x::rest, ys ->
      List.map (fun y -> (x, y)) (List.filter (p x) ys) @ cross_pair_filter p rest ys
