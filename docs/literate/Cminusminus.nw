\[\inferrule [Narrow \sidecond{n\leq w\leq w'}]
{\tenv,\menv \derives e \trans{c} \e :: \fty{n} : \bits{w'} \\
 \lo{w}{w'} \in \menv}
{\tenv,\menv \derives e \trans{c+1} \lo{w}{w'} \e :: \fty{n} :
\bits{w}}
\]
